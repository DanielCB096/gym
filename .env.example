# Global
APP_NAME=gym-manager
APP_ENV=development
APP_TIMEZONE=America/Mexico_City
APP_CURRENCY=MXN

# Backend
# Local demo only: simulates payments, access checks, CFDI stamping and emails
# (account statements and invoice delivery).
PREVIEW_MODE=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gym_db
REDIS_URL=redis://localhost:6379/0
# Also signs the member login codes (HMAC). Replace it in production: with the
# placeholder value the member portal refuses to issue codes (503).
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# Explicit allowlist for browser clients (Expo web preview runs on 8081). The
# member app is Bearer-only, so credentials stay disabled. Empty = no CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081,http://127.0.0.1:8081
GYM_API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:3000

# Payment gateway
PAYMENT_PROVIDER=conekta
PAYMENT_API_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# CFDI / PAC
# With PREVIEW_MODE=true or PAC_PROVIDER=simulated the stamp is simulated (no SAT
# UUID, no fiscal value). PAC_PROVIDER=finkok uses the real Finkok adapter; without
# credentials (or with any other provider) stamping responds 503 instead of
# issuing a fake CFDI. Test it against the demo with `backend/finkok_demo.py`.
PAC_PROVIDER=finkok
PAC_USER=replace-me
PAC_PASSWORD=replace-me
PAC_PRODUCTION=false
# Optional: override the Finkok host, the RFC used to cancel (falls back to
# GYM_RFC), the issuer CSD in PEM for cancellation (key already encrypted in
# 3DES with Finkok's passphrase) and the request timeout.
# PAC_BASE_URL=
# PAC_TAXPAYER_ID=
# PAC_CERT_PATH=
# PAC_KEY_PATH=
PAC_TIMEOUT_SECONDS=30
# Issuer data printed on the comprobante. The values below are placeholders
# with a valid shape; replace them with the club's real fiscal data and validate
# them with the accountant before stamping in production.
CFDI_SERIES=A
CFDI_TAX_RATE_PERCENT=16
GYM_RFC=XAXX010101000
GYM_LEGAL_NAME=Centro Fit
GYM_TAX_REGIME=601
GYM_POSTAL_CODE=00000
CFDI_CERTIFICATE_NUMBER=00000000000000000000
CFDI_PRODUCT_CODE=01010101
CFDI_SERVICE_CODE=90121500

# WhatsApp / notifications
WHATSAPP_TOKEN=replace-me
# Shared SMTP transport for account statements and CFDI delivery (PDF + XML).
# Use TLS in production; PREVIEW_MODE simulates sending without contacting it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=reception@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
# Printed on the member account statement PDF (defaults to "Centro Fit").
GYM_NAME=Centro Fit

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Security
TWO_FACTOR_REQUIRED_FOR_ADMIN=true

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
