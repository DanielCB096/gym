# Global
APP_NAME=gym-manager
APP_ENV=development
APP_TIMEZONE=America/Mexico_City
APP_CURRENCY=MXN

# Backend
# Local demo only: simulates payments, access checks and statement emails.
PREVIEW_MODE=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gym_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
GYM_API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:3000

# Payment gateway
PAYMENT_PROVIDER=conekta
PAYMENT_API_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# CFDI / PAC
# The real PAC adapter is not implemented yet. With PREVIEW_MODE=true or
# PAC_PROVIDER=simulated the stamp is simulated (no SAT UUID, no fiscal value);
# any other provider makes stamping respond 503 instead of issuing a fake CFDI.
PAC_PROVIDER=finkok
PAC_USER=replace-me
PAC_PASSWORD=replace-me
PAC_PRODUCTION=false
# Issuer data printed on the comprobante. The values below are placeholders
# with a valid shape; replace them with the club's real fiscal data and validate
# them with the accountant before stamping in production.
CFDI_SERIES=A
CFDI_TAX_RATE_PERCENT=16
GYM_RFC=XAXX010101000
GYM_LEGAL_NAME=Centro Fit
GYM_TAX_REGIME=601
GYM_POSTAL_CODE=00000
CFDI_CERTIFICATE_NUMBER=00000000000000000000
CFDI_PRODUCT_CODE=01010101
CFDI_SERVICE_CODE=90121500

# WhatsApp / notifications
WHATSAPP_TOKEN=replace-me
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=reception@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
# Printed on the member account statement PDF (defaults to "Centro Fit").
GYM_NAME=Centro Fit

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Security
TWO_FACTOR_REQUIRED_FOR_ADMIN=true

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
