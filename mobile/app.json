{
  "expo": {
    "name": "Centro Fit Socio",
    "slug": "centro-fit-socio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.centrofit.socio",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Permite tomar fotos de progreso para tu historial personal.",
        "NSPhotoLibraryUsageDescription": "Permite elegir fotos de progreso desde tu biblioteca.",
        "NSPhotoLibraryAddUsageDescription": "Permite guardar documentos o imágenes relacionadas con tu cuenta."
      }
    },
    "android": {
      "package": "com.centrofit.socio",
      "adaptiveIcon": {
        "backgroundColor": "#07110D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de progreso desde tu biblioteca.",
          "cameraPermission": "Permite tomar fotos de progreso con la cámara."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90abae9f-0051-44f2-9c5f-c83a2caaa10e"
      }
    },
    "owner": "danielcb096s-team"
  }
}
